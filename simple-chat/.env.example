APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./data/chat.db
LLM_BASE_URL=http://127.0.0.1:3000/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=sensenova-6.8-flash-lite
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=3
# 上下文总预算（含系统提示与回复预留），非单次回答的 max_tokens
MAX_CONTEXT_TOKENS=8192
# 受信反向代理 IP 列表（JSON 数组格式；仅当非空时才采信 X-Forwarded-For 取真实客户端 IP）
# TRUSTED_PROXIES=["10.0.0.1","10.0.0.2"]
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ── PR-3 观测性 / 成本 ──
# /api/admin/cost 的管理密钥：留空 = 端点返回 501（不强制启用）；配置后请求须带 X-Admin-Key 头
ADMIN_API_KEY=
# 每百万 token 价格（USD），按模型名配置（pydantic-settings 的 dict 仅接受 JSON 格式）；
# 未配置该模型时 cost_usd=0，不报错
# MODEL_PRICE={"sensenova-6.8-flash-lite": {"prompt": 0.15, "completion": 0.60}}

# ── v0.2 多用户与认证 ──
# 认证开关：留空 = 由 APP_ENV 推导（production 开 / development 关）。
# 关闭时保留 X-User-Id 兼容路径；生产务必保持开启。
AUTH_ENABLED=
# 会话 Cookie 的 HMAC 签名密钥。生产 + 认证开启时强制非空且 >= 32 字符，否则启动失败。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 轮换该值会让全部旧 Cookie 立即失效（全员重新登录）。
SESSION_SECRET=
# 会话有效期（秒），默认 7 天
SESSION_TTL_SECONDS=604800
# Cookie 名与 Secure 属性；Secure 留空 = 生产自动开（HTTPS），纯 HTTP 部署显式设 false
SESSION_COOKIE_NAME=sc_session
SESSION_COOKIE_SECURE=
# 登录/注册独立限流桶（按 IP+用户名计失败次数，与全局限流互不影响）
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# scrypt 成本参数（N 必须为 2 的幂；如无特殊需要不要下调）
SCRYPT_N=16384
SCRYPT_R=8
SCRYPT_P=1

# ── v0.3 多模型路由与预算 ──
# 路由开关：留空 = 由 APP_ENV 推导（生产开 / 开发关）。关闭时全部走 LLM_MODEL。
ROUTING_ENABLED=
# 模型白名单（JSON 数组）；显式请求的 model 必须在白名单内。留空 = 仅允许 LLM_MODEL。
# MODEL_WHITELIST=["sensenova-6.8-flash-lite","gpt-4o-mini"]
# 路由规则（JSON 数组，按顺序首条命中）：match.min_len / match.keywords（正则）
# ROUTING_RULES=[{"match":{"min_len":200,"keywords":["代码","bug"]},"model":"gpt-4o"}]
# Fallback 模型列表（JSON 数组）：仅当尚未产出 token 时降级一次，不级联。
# FALLBACK_MODELS=["gpt-4o-mini"]
# 每用户日 token 预算：0 = 不限制（即便 BUDGET_ENABLED=true）。按 UTC 日期边界恢复。
BUDGET_ENABLED=
BUDGET_DAILY_TOKENS_PER_USER=0

# ── v0.4 工作记忆（每 N 轮摘要，禁向量数据库） ──
# 开关：留空 = 由 APP_ENV 推导。关闭时回到 40 条原文窗口 + token 裁剪。
MEMORY_ENABLED=
MEMORY_SUMMARY_EVERY_N=20
# 摘要使用的模型；留空 = 复用 LLM_MODEL（建议配一个便宜模型）。
MEMORY_SUMMARY_MODEL=
MEMORY_SUMMARY_MAX_TOKENS=512
MEMORY_SUMMARY_MAX_CHARS=1200
MEMORY_RAW_WINDOW=40

# ── v0.5 工具调用（沙盒 + 3 工具） ──
# 开关：留空 = 由 APP_ENV 推导。关闭时不向模型暴露 tools。
TOOLS_ENABLED=
TOOL_CALCULATE_ENABLED=true
TOOL_READ_FILE_ENABLED=true
TOOL_WEB_SEARCH_ENABLED=true
# read_file 白名单根目录（JSON 数组）；realpath 解析后必须落在某根目录内。
# TOOL_READ_ROOTS=["./docs","./reports"]
# web_search 受控 egress broker endpoint（未配置时返回 NOT_CONFIGURED，不联网）。
TOOL_WEB_SEARCH_ENDPOINT=
TOOL_WEB_SEARCH_API_KEY=
# 沙盒资源上限（calculate/read_file 永远禁网；web_search 经 broker）
TOOL_SANDBOX_CPU_SECONDS=1
TOOL_SANDBOX_MEMORY_MB=128

# ── v0.6 RAG（私有文档检索；MVI 用 SQLite FTS5，禁向量数据库） ──
# 开关：留空 = 由 APP_ENV 推导。关闭时不检索不注入。
RAG_ENABLED=
# 文档扫描根目录（JSON 数组）；只从白名单目录扫描，不接受任意路径上传。
# RAG_DOC_ROOTS=["./docs"]
RAG_TOP_K=3
# 检索结果注入上下文的 token 上限（按 score 截断）
RAG_MAX_CONTEXT_TOKENS=2048
