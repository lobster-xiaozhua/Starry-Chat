APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./data/chat.db
LLM_BASE_URL=http://127.0.0.1:3000/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=sensenova-6.8-flash-lite
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=3
# 上下文总预算（含系统提示与回复预留），非单次回答的 max_tokens
MAX_CONTEXT_TOKENS=8192
# 受信反向代理 IP 列表（JSON 数组格式；仅当非空时才采信 X-Forwarded-For 取真实客户端 IP）
# TRUSTED_PROXIES=["10.0.0.1","10.0.0.2"]
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ── PR-3 观测性 / 成本 ──
# /api/admin/cost 的管理密钥：留空 = 端点返回 501（不强制启用）；配置后请求须带 X-Admin-Key 头
ADMIN_API_KEY=
# 每百万 token 价格（USD），按模型名配置（pydantic-settings 的 dict 仅接受 JSON 格式）；
# 未配置该模型时 cost_usd=0，不报错
# MODEL_PRICE={"sensenova-6.8-flash-lite": {"prompt": 0.15, "completion": 0.60}}
